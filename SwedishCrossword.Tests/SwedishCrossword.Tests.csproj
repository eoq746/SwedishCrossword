<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    
    <!-- TUnit specific properties for better VS integration -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.57.0" />
    <PackageReference Include="TUnit.Assertions" Version="1.57.0" />
    <PackageReference Include="TUnit.Engine" Version="1.57.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwedishCrossword.Core\SwedishCrossword.Core.csproj" />
  </ItemGroup>

</Project>
