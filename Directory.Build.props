<Project>

  <!--
    Repo-wide MSBuild defaults. Applied to every project in the solution.
    Keeps per-project .csproj files focused on what's unique to that project.
  -->
  <PropertyGroup>
    <!-- Run built-in code-style analyzers during build (and therefore in CI),
         not only inside the IDE. Violations that dotnet format would flag
         become build warnings so they show up in PR checks. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Use the recommended analyzer set for the latest .NET.
         'latest-recommended' is stricter than the default 'latest'. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Generate documentation XML only when explicitly requested per-project. -->
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Auto-configure the repo-local Git hooks path on first build so every
    contributor gets the pre-commit hook that enforces UTF-8 BOM on .cs files
    and runs `dotnet format style` on staged changes. Runs at most once per
    clone (guarded by a marker file under obj/).
  -->
  <Target Name="ConfigureGitHooksPath"
          BeforeTargets="BeforeBuild"
          Condition="Exists('$(MSBuildThisFileDirectory).git') And !Exists('$(MSBuildThisFileDirectory).git\.hookspath-configured')">
    <Exec Command="git config core.hooksPath .githooks"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ContinueOnError="true"
          IgnoreExitCode="true" />
    <WriteLinesToFile File="$(MSBuildThisFileDirectory).git\.hookspath-configured"
                      Lines="configured"
                      Overwrite="true"
                      Condition="Exists('$(MSBuildThisFileDirectory).git')" />
  </Target>

</Project>
